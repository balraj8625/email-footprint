# Copy this file to .env.local and fill in your keys

# Cloudflare Turnstile CAPTCHA (https://dash.cloudflare.com/?to=/:account/turnstile)
# Free tier. For local dev testing, you can use Cloudflare's standard always-pass test keys:
# Site Key: 1x00000000000000000000AA
# Secret Key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend email API (https://resend.com) - Optional: local dev fallback logs OTP to console
RESEND_API_KEY=

# Redis for distributed OTP storage (optional - defaults to server in-memory store)
REDIS_URL=redis://localhost:6379

# App URL (used for verification callbacks/links)
NEXT_PUBLIC_APP_URL=http://localhost:3000


